#!/bin/bash
#
# MUTHUR OS native session wrapper.
# Launches MUTHUR as the fullscreen interface.
#
# Usage: Called by display manager when user selects "MUTHUR OS" session
#

set -e

# Logging
LOG_FILE="${XDG_RUNTIME_DIR:-/tmp}/muthur-session.log"
exec 1>> "$LOG_FILE"
exec 2>&1

echo "[$(date)] MUTHUR native session starting"

# Environment setup
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=MUTHUR
export MUTHUR_SESSION_MODE=native

SESSION_HOST="${MUTHUR_SESSION_HOST:-}"
if [ -z "$SESSION_HOST" ]; then
    SESSION_HOST="$(command -v cage 2>/dev/null || true)"
fi

if [ -z "$SESSION_HOST" ]; then
    echo "ERROR: native fullscreen session host unavailable"
    notify-send -u critical "MUTHUR Session Error" "Native fullscreen session host unavailable" 2>/dev/null
    exit 1
fi

# Check if MUTHUR binary exists
if [ ! -x "/usr/local/bin/muthur-bin" ] && [ ! -x "/usr/bin/muthur-os-terminal" ]; then
    echo "ERROR: muthur-bin not found"
    notify-send -u critical "MUTHUR Session Error" "MUTHUR binary not found" 2>/dev/null
    exit 1
fi

# Wait for DRM/KMS to be ready
sleep 0.5

echo "[$(date)] Handing display to MUTHUR"
MUTHUR_BIN="$(command -v muthur-bin 2>/dev/null || echo /usr/local/bin/muthur-bin)"
exec "$SESSION_HOST" -d -- "$MUTHUR_BIN" --fullscreen-force --session-mode
