# Maintainer: MUTHUR Development <noreply@github.com>
#
# Builds MUTHUR from source (there are no prebuilt release binaries).
# Local test build from a checkout:
#   MUTHUR_PKG_SOURCE="git+file:///path/to/Muthur-os-terminal#branch=main" makepkg -si

pkgname=muthur-os-terminal-git
pkgver=0.1.1
pkgrel=1
pkgdesc="Cinematic terminal inspired by MU/TH/UR 6000 and eDEX-UI, with a terminal-only CLI"
arch=('x86_64')
url="https://github.com/krko2n/Muthur-os-terminal"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gst-plugins-base'  # WebKit media/audio; the boot sound aborts WebKit without it
  'gst-plugins-good'  # provides autoaudiosink
  'nodejs'   # terminal-only CLI (muthur status, muthur config show)
)
makedepends=('git' 'npm' 'rust')
optdepends=(
  'ollama: optional local AI assistant'
  'cage: fullscreen kiosk session host'
  'greetd: boot straight into MUTHUR'
)
provides=('muthur-os-terminal')
conflicts=('muthur-os-terminal' 'muthur-os-terminal-bin')
source=("muthur::${MUTHUR_PKG_SOURCE:-git+https://github.com/krko2n/Muthur-os-terminal.git}")
sha256sums=('SKIP')
# makepkg's default LTO compiles bundled C crypto (aws-lc-sys) to GCC bitcode
# that the Rust link step cannot resolve (undefined aws_lc_* symbols).
options=('!lto')

pkgver() {
  cd muthur
  printf '%s.r%s.%s' \
    "$(node -p "require('./package.json').version")" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

build() {
  cd muthur
  npm ci --legacy-peer-deps
  npm run build
  npm run build:cli
  cd src-tauri
  cargo build --release --locked
}

check() {
  cd muthur
  npm test
  cd src-tauri
  cargo test --release --locked
}

package() {
  cd muthur

  install -Dm755 src-tauri/target/release/muthur-os-terminal "$pkgdir/usr/bin/muthur-os-terminal"
  install -Dm755 dist-cli/muthur.cjs "$pkgdir/usr/lib/muthur/muthur-cli.cjs"

  # 'muthur <command>' is the terminal-only CLI; plain 'muthur' opens the GUI.
  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/muthur" <<'EOF'
#!/bin/sh
if [ "$#" -gt 0 ]; then
  exec node /usr/lib/muthur/muthur-cli.cjs "$@"
fi
exec /usr/bin/muthur-os-terminal
EOF
  chmod 755 "$pkgdir/usr/bin/muthur"

  install -Dm755 packaging/bin/kys "$pkgdir/usr/bin/kys"
  install -Dm755 packaging/bin/muthur-ui "$pkgdir/usr/bin/muthur-ui"
  install -Dm755 packaging/muthur-session "$pkgdir/usr/bin/muthur-session"

  install -Dm644 packaging/muthur.desktop "$pkgdir/usr/share/applications/muthur.desktop"
  install -Dm644 packaging/muthur-session.desktop "$pkgdir/usr/share/wayland-sessions/muthur.desktop"
  # Autostart is opt-in per user via 'muthur-ui enable', not forced on everyone.
  install -Dm644 packaging/muthur-autostart.desktop "$pkgdir/usr/share/muthur/muthur-autostart.desktop"

  install -Dm644 examples/config.toml.example "$pkgdir/etc/muthur/config.toml.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/muthur-os-terminal/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
