#!/bin/bash
#
# kys - MUTHUR OS System Shutdown Command
#
# Initiates a clean system shutdown with a 10-second cancelable countdown.
# Uses loginctl (systemd-logind) for unprivileged shutdown on modern Linux.
#
# Usage: kys
# Cancel: Ctrl+C during countdown
#

set -e

# Colors
RED='\033[1;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
DIM='\033[2m'
RESET='\033[0m'
BOLD='\033[1m'

# Trap Ctrl+C for clean cancel
cancelled=false
trap 'cancelled=true' INT

echo ""
echo -e "${RED}================================================================${RESET}"
echo -e "${RED}     MUTHUR://SYSTEM SHUTDOWN INITIATED${RESET}"
echo -e "${RED}================================================================${RESET}"
echo ""
echo -e "${YELLOW}  WARNING: This will power off your system.${RESET}"
echo -e "${YELLOW}  All unsaved work will be lost.${RESET}"
echo ""
echo -e "${DIM}  Press Ctrl+C within 10 seconds to cancel.${RESET}"
echo ""

# Countdown
for i in $(seq 10 -1 1); do
    if [ "$cancelled" = true ]; then
        echo ""
        echo -e "${GREEN}  Shutdown cancelled.${RESET}"
        echo ""
        exit 0
    fi
    printf "\r  ${BOLD}Shutting down in ${RED}%2d${RESET}${BOLD} seconds...${RESET}" "$i"
    sleep 1
done

# Final check after countdown
if [ "$cancelled" = true ]; then
    echo ""
    echo -e "${GREEN}  Shutdown cancelled.${RESET}"
    echo ""
    exit 0
fi

echo ""
echo ""
echo -e "${RED}  EXECUTING SHUTDOWN...${RESET}"
echo ""

# Tiered shutdown execution
if command -v loginctl &> /dev/null; then
    exec loginctl poweroff
elif command -v systemctl &> /dev/null; then
    exec systemctl poweroff
else
    echo -e "${YELLOW}  Requires elevated privileges...${RESET}"
    exec sudo shutdown -h now
fi
