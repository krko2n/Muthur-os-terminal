{
  "name": "muthur-os-terminal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "author": "MUTHUR Development",
  "description": "MUTHUR OS Terminal - A cinematic terminal emulator with AI integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/krko2n/Muthur-os-terminal"
  },
  "homepage": "https://github.com/krko2n/Muthur-os-terminal",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "format:check": "node scripts/check-format.cjs",
    "installer:check": "node scripts/check-installer.cjs",
    "audit:npm": "npm audit --audit-level=moderate",
    "audit:cargo": "cd src-tauri && cargo audit",
    "audit:cargo-deny": "cd src-tauri && cargo deny check",
    "audit": "npm run audit:npm && npm run audit:cargo && npm run audit:cargo-deny",
    "test": "node scripts/smoke-test.cjs",
    "version:check": "node scripts/version-check.cjs",
    "build": "tsc && node -r ./scripts/vite-no-cmd-netuse.cjs ./node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "vite preview",
    "tauri": "tauri",
    "update:readme-stats": "node scripts/update-readme-stats.cjs",
    "check:readme-stats": "node scripts/update-readme-stats.cjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "@react-three/fiber": "^9.0.10",
    "@react-three/drei": "^9.117.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "@types/topojson-client": "^3.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
